# Secrets only. Everything else lives in seshat.toml; see seshat.example.toml.
#
#   cp .env.example .env
#
# Copy to .env and replace every placeholder before starting the Compose stack.

# Compose builds SESHAT_DATABASE_URL from this and hands the same password to
# PostgreSQL, so the two can never drift apart.
SESHAT_POSTGRES_PASSWORD=replace-with-a-long-random-database-password

SESHAT_API_TOKEN=replace-with-a-random-api-token-of-at-least-16-characters
SESHAT_CURSOR_SIGNING_KEY=replace-with-a-random-cursor-key-of-at-least-32-characters
SESHAT_EMBEDDING_API_KEY=replace-with-your-embedding-provider-key

# Required only when converter.backend = "azure" in seshat.toml.
# AZURE_OCR_API_KEY=replace-with-your-azure-document-intelligence-key
